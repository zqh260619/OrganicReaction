# =============================================================================
# OrganicReaction 工作区忽略规则
#
# 跟踪：源码、文档、VS 工程文件、各作品的最终成片（media/videos/<作品>/1080p60/test.mp4）
# 不跟踪：渲染中间产物、测试渲染、本地音频、test.py
# 参考：https://github.com/github/gitignore
# =============================================================================

# ------------------------------- Python --------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --------------------------- Visual Studio -----------------------------------
# 用户级设置与 IDE 缓存
.vs/
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs

# 编译输出与调试中间文件（本项目目前没有，保留以防 VS 生成）
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
ipch/
*.aps
*.cachefile
*.VC.db
*.pdb
*.ilk
*.obj
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.log
*.tmp

# --------------------------- manim 渲染产物 ----------------------------------
# LaTeX 中间文件与文本缓存（每次渲染可重新生成）
/media/Tex/
/media/texts/

# 逐动画的中间片段（所有作品与测试；只忽略 partial_movie_files 目录）
/media/videos/**/partial_movie_files/

# 测试渲染（本地验证用，不跟踪）
/media/videos/test/
/media/images/test/

# 旧测试脚本 testp.py 的渲染目录
/media/videos/testp/
/media/images/testp/

# 其它作品的图片输出（只保留 SubstitutionReaction1 与 VideoCover 的成图）
/media/images/SubstitutionReaction2/
/media/images/SubstitutionReaction3/

# 低画质测试渲染
/media/videos/SubstitutionReaction3/480p15/

# 临时渲染目录
/media/images/_render_*/
/media/images/_tmp_*/

# --------------------------- 本地文件 ----------------------------------------
# 测试脚本与本地音频
/test.py
/audios/

# 本地计划文件
/.zcode/plans/
